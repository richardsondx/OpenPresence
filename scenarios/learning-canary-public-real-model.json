{
  "name": "Public real-model learning canary",
  "sourceType": "scenario",
    "steps": [
      { "command": "start", "options": { "source": "scenario" } },
      { "command": "consider" },
      { "command": "assert-own-posts", "options": { "minimum": 1 } },
      { "command": "metric", "options": { "object": "$latest-own-post-id", "metrics": { "impressions": 180, "likes": 1, "replies": 0, "reposts": 0, "quotes": 0 }, "publicationAgeSeconds": 3600 } },
      { "command": "inject", "options": { "actor": "Maya Chen", "handle": "@mayachen", "action": "post", "content": "We doubled activation after removing invited users from the denominator. The mechanism mattered more than the headline." } },
      { "command": "inject", "options": { "actor": "Rafi Cole", "handle": "@raficole", "action": "post", "content": "Our polished launch thread got attention but no qualified conversations. The format looked right; the evidence was thin." } },
      { "command": "metric", "options": { "object": "$latest-inbound-id", "metrics": { "impressions": 9200, "likes": 320, "replies": 61, "reposts": 48, "quotes": 16 }, "publicationAgeSeconds": 7200 } },
      { "command": "consider" },
      { "command": "advance", "options": { "minutes": 2880 } },
      { "command": "consider" },
      { "command": "assert-own-posts", "options": { "minimum": 2 } },
      { "command": "metric", "options": { "object": "$latest-own-post-id", "metrics": { "impressions": 4100, "likes": 140, "replies": 34, "reposts": 24, "quotes": 9 }, "publicationAgeSeconds": 3600 } },
      { "command": "inject", "options": { "actor": "Maya Chen", "handle": "@mayachen", "action": "reply", "target": "$latest-object", "content": "Which denominator would you use for this activation result, and what evidence would change your mind? Our team is still deciding." } },
      { "command": "consider" },
      { "command": "inject", "options": { "actor": "Maya Chen", "handle": "@mayachen", "action": "reply", "target": "$latest-own-reply", "content": "That eligibility split is exactly what we checked next. The activation result changed once we excluded invited users who could not activate." } },
      { "command": "consider" },
      { "command": "audience", "options": { "followers": 12 } },
      { "command": "review", "options": { "kind": "weekly" } },
      { "command": "advance", "options": { "minutes": 1440 } },
      { "command": "consider" },
      { "command": "assert-own-posts", "options": { "minimum": 3 } },
      { "command": "consider" },
      { "command": "metric", "options": { "object": "$latest-own-post-id", "metrics": { "impressions": 3600, "likes": 120, "replies": 28, "reposts": 19, "quotes": 7 }, "publicationAgeSeconds": 3600 } },
      { "command": "review", "options": { "kind": "weekly" } },
      { "command": "advance", "options": { "minutes": 10080 } },
      { "command": "consider" },
      { "command": "advance", "options": { "minutes": 1440 } },
      { "command": "consider" },
      { "command": "timeline" }
  ]
