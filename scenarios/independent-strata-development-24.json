    { "command": "inject", "options": { "actor": "Alix Chen", "handle": "@alixchen", "action": "post", "content": "The p95 latency chart drops after the cache change, but the sample excludes cold starts. What conclusion survives?", "assets": [{ "name": "latency-chart.png", "kind": "chart", "path": "scenarios/fixtures/agent-quality-chart.png" }] } },
