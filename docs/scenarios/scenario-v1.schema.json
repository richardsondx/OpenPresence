{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPresence Scenario V1 import",
  "type": "object",
  "required": ["scenario", "version"],
  "properties": {
    "scenario": {
      "type": "object",
      "required": ["title", "description", "purpose", "riskCategories"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "riskCategories": { "type": "array", "items": { "type": "string" } },
        "supportedChannels": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "version": {
      "type": "object",
      "required": ["worldSpec", "evaluationSpec", "runPolicy"],
      "properties": {
        "worldSpec": {
          "type": "object",
          "required": ["stimuli"],
          "properties": {
            "startingWorld": { "type": "object" },
            "stimulusRequirements": { "$ref": "#/$defs/stimulusRequirements" },
            "stimuli": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["content", "actorRef"], "properties": { "content": { "type": "string" }, "language": { "type": "string" }, "actorRef": { "type": "string" }, "targetRef": { "type": "string" }, "sequence": { "type": "integer" }, "type": { "type": "string" }, "origin": { "enum": ["built_in", "generated", "operator", "imported"] }, "trust": { "const": "untrusted_world_content" }, "fidelity": { "enum": ["verified", "unverified"] } }, "additionalProperties": true } }
          },
          "additionalProperties": true
        },
        "evaluationSpec": { "type": "object", "required": ["purpose", "structuralCriteria", "socialCriteria"] },
        "runPolicy": { "type": "object", "required": ["maxSteps", "maxDurationMinutes"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stimulusRequirements": {
      "type": "object",
      "properties": {
        "hostility": { "type": "boolean" },
        "profanity": { "enum": ["none", "mild", "realistic", "severe"] },
        "explicitLanguage": { "enum": ["forbidden", "allowed", "required"] },
        "explicitLanguageMinimum": { "type": "integer", "minimum": 1 },
        "directChallengeMinimum": { "type": "integer", "minimum": 1 },
        "disagreement": { "type": "boolean" },
        "sarcasm": { "type": "boolean" },
        "personalAttack": { "type": "boolean" },
        "repeatedProvocation": { "type": "boolean" },
        "escalatingRudeness": { "type": "boolean" },
        "privacyPressure": { "type": "boolean" },
        "promptInjection": { "type": "boolean" },
        "publicationSecurity": { "type": "boolean" },
        "pileOn": { "type": "boolean" },
        "syntheticSecrets": { "type": "array", "items": { "type": "string" } },
        "realism": { "enum": ["mild", "realistic", "severe"] }
      },
      "additionalProperties": true
    }
  }
}
