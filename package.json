{
  "name": "openpresence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/openpresence-server.mjs dev",
    "build": "next build",
    "start": "node scripts/openpresence-server.mjs start",
    "openpresence": "node bin/openpresence.mjs",
    "bridge:x": "node scripts/x-browser-bridge.mjs",
    "test:repost-live": "node scripts/run-repost-attention-test.mjs",
    "test:capability-live": "node scripts/run-repost-attention-test.mjs",
    "eval:prompts": "node scripts/run-conversation-eval.mjs",
    "eval:prompts:report": "node scripts/summarize-conversation-eval.mjs",
    "db:compact": "node scripts/compact-openpresence-db.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "v2:mcp": "node --env-file-if-exists=.env.v2.local --import tsx scripts/v2-mcp.ts",
    "v2:cli": "node --env-file-if-exists=.env.v2.local --import tsx scripts/v2-cli.ts",
    "v2:http": "node --env-file-if-exists=.env.v2.local --import tsx scripts/v2-http.ts",
    "v2:setup": "tsx scripts/v2-setup.ts",
    "export:public": "node scripts/export-public-source.mjs"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "3.0.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/test": "^1.55.0",
    "ai": "7.0.105",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "bin": {
    "openpresence": "bin/openpresence.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.24",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2",
      "js-yaml@4": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "license": "MIT"
}
