{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "/var/folders/yv/1mjm9zl16kj8gykks67kp7j40000gn/T/openpresence-verify-00e51d1719/next-dist/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "remotion-jev-qa",
    "out",
    "tmp",
    "var",
    "qa-learnings",
    ".next-*"
  ]
}
