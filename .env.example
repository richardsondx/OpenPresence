# Local runtime routing is managed by pnpm openpresence runtime.
# First run only: OPENPRESENCE_ALLOW_DATABASE_INIT=1 pnpm dev
# The default workspace uses data/openpresence-main.db on port 3015.
# OPENPRESENCE_PROFILE=regular
# OPENPRESENCE_ALLOW_RUNTIME_OVERRIDE=1 permits intentional isolated overrides.

# Required before storing credentials in a production deployment.
# Generate with openssl rand -base64 32. Keep the key private with database backups.
OPENPRESENCE_SECRET_KEY=

# Optional local EvidenceVisual corpus adapter.
EVIDENCE_VISUAL_URL=http://127.0.0.1:8787

# Test-only flags; never enable in production.
# OPENPRESENCE_TEST_MODE=1
# OPENPRESENCE_AI_MOCK=1
# OPENPRESENCE_X_API_MOCK=1
