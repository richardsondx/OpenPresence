# Local runtime routing is managed by `pnpm openpresence runtime`.
# The regular profile reads the canonical database manifest and pins the
# immutable Agent/Presence IDs. Use OPENPRESENCE_PROFILE=<name> only when
# intentionally running another registered profile.
# OPENPRESENCE_PROFILE=regular
# OPENPRESENCE_ALLOW_RUNTIME_OVERRIDE=1 is reserved for isolated test/dev
# servers that explicitly override a profile's database or port.

# Development safety: the temporal/autonomy loop is opt-in because Next's
# development compiler otherwise loads the full worker graph at boot. Set this
# only when you intentionally want recurring local autonomy while developing.
# OPENPRESENCE_ENABLE_TEMPORAL_ENGINE=1

# Read-only local EvidenceVisual corpus adapter.
EVIDENCE_VISUAL_URL=http://127.0.0.1:8787

# Required when running a production build with encrypted provider or channel credentials.
# Generate with: openssl rand -base64 32
OPENPRESENCE_SECRET_KEY=

# Optional: only for local API fixtures and automated tests. Never enable in production.
# OPENPRESENCE_X_API_MOCK=1
